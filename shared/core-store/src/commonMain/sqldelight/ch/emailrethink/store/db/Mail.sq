CREATE TABLE account (
  id TEXT NOT NULL PRIMARY KEY,
  email TEXT NOT NULL,
  display_name TEXT,
  transport_kind TEXT NOT NULL,
  imap_host TEXT,
  imap_port INTEGER
);

CREATE TABLE folder (
  id TEXT NOT NULL PRIMARY KEY,
  account_id TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
  remote_name TEXT NOT NULL,
  display_name TEXT NOT NULL,
  uid_validity INTEGER,
  UNIQUE(account_id, remote_name)
);

CREATE TABLE message (
  id TEXT NOT NULL PRIMARY KEY,
  folder_id TEXT NOT NULL REFERENCES folder(id) ON DELETE CASCADE,
  remote_uid INTEGER NOT NULL,
  message_id_header TEXT,
  sender TEXT,
  subject TEXT,
  sent_at INTEGER,
  received_at INTEGER,
  is_read INTEGER NOT NULL DEFAULT 0,
  snippet TEXT,
  UNIQUE(folder_id, remote_uid)
);

CREATE INDEX message_by_folder_date ON message(folder_id, received_at DESC);
CREATE INDEX folder_by_account ON folder(account_id);

selectInbox:
SELECT message.* FROM message
JOIN folder ON folder.id = message.folder_id
WHERE folder.account_id = ? AND folder.remote_name = ?
ORDER BY message.received_at DESC
LIMIT ?;

selectFolders:
SELECT * FROM folder WHERE account_id = ? ORDER BY display_name;

upsertAccount:
INSERT OR REPLACE INTO account(id, email, display_name, transport_kind, imap_host, imap_port)
VALUES (?, ?, ?, ?, ?, ?);

upsertFolder:
INSERT OR REPLACE INTO folder(id, account_id, remote_name, display_name, uid_validity)
VALUES (?, ?, ?, ?, ?);

upsertMessage:
INSERT OR REPLACE INTO message(id, folder_id, remote_uid, message_id_header, sender, subject, sent_at, received_at, is_read, snippet)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
